ACCESS_SECRET_KEY=your_access_secret_key
ADMIN_CONTACT_EMAIL=your_admin_email@example.com
ALLOWED_HOSTS=localhost:8000
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/db_name
EMAIL_FROM=no-reply@example.com
EMAIL_PASS=your_email_password
EMAIL_USER=your_email_user@example.com
ENABLE_SENTIMENT_AUDIT=true
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key
# Text-generation models: GEMINI_MODEL is tried first, GEMINI_FALLBACK_MODEL if it fails.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Embedding model for profile vectors (768-dim). No fallback: changing it requires re-embedding all profiles.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
JWT_SECRET=your_jwt_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:5173/auth/linkedin/callback

PORT=3435
REFRESH_SECRET_KEY=your_refresh_secret_key
RESEND_API_KEY=your_resend_api_key
STRIPE_PRIVATE_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# Chat content moderation (bad-words). Comma-separated word lists.
ENABLE_CONTENT_MODERATION=true
MODERATION_EXTRA_WORDS=
MODERATION_ALLOWED_WORDS=
MODERATION_SEVERE_WORDS=

# Account deletion. Deleted accounts wait in the admin "Pending erasure" queue;
# the badge counts down from this many days (UK GDPR: erase within one month).
ACCOUNT_ERASE_DEADLINE_DAYS=28
# Secret for hashing the emails of banned accounts so they can't sign up again
# after erasure. Required before an admin can erase a banned account.
EMAIL_HASH_SECRET=
